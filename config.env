# Single source of truth for the repository's public address and inputs.
# Sourced by the scripts; the site templates carry @BASE_URL@ and are filled in
# from it at build time (see scripts/build-repos.sh).
BASE_URL=https://pkg.npad.dev
# Where the .deb / .rpm release assets come from
SOURCE_REPO=platima/npad
# How many of the newest stable releases stay installable from the repositories
KEEP_RELEASES=5
# Architectures published, in each format's own spelling (amd64 is x86_64,
# arm64 is aarch64). apt gets one binary-<arch> index per entry, all named in
# the Release and npad.sources Architectures fields; the dnf repository holds
# every rpm architecture in one tree and dnf picks its own. An architecture
# missing from older releases (arm64 and riscv64 start with npad v0.35.0) is
# still published, as an empty index, so apt on it never finds a file missing.
DEB_ARCHES="amd64 arm64 riscv64"
RPM_ARCHES="x86_64 aarch64 riscv64"
